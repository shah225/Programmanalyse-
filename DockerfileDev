FROM ubuntu:latest

RUN apt-get update && \
    DEBIAN_FRONTEND=noninteractive apt-get install -y \
        build-essential \
        cmake \
        ninja-build \
        git \
        python3 \
        python3-venv \
        python3-pip \
        openjdk-17-jre-headless \
        libz3-dev \
        gdb \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /verifier

CMD ["bash"]